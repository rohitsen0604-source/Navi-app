PORT=5000
NODE_ENV=development

# Database connection:
# Naavi backend uses Mongoose (MongoDB). Use a MongoDB connection string.
# (Note: PostgreSQL / NeonDB links are not supported by Mongoose)
# For Free Cloud MongoDB: Create a free cluster on MongoDB Atlas (mongodb.com/atlas)
# If left empty, backend automatically runs in In-Memory mode for instant testing!
MONGO_URI=mongodb://127.0.0.1:27017/naavi_db

# Redis connection (optional, falls back to in-memory locks if omitted)
REDIS_URL=redis://127.0.0.1:6379

# Security
JWT_SECRET=naavi_production_secret_key_2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# SMS / OTP (MSG91) - Default fallback test OTP is always: 123456
MSG91_AUTH_KEY=your_msg91_key
MSG91_OTP_TEMPLATE_ID=your_otp_template

# Telephony (Exotel)
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
